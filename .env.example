# 이 파일을 .env 로 복사한 뒤 실제 키를 채워 넣으세요.
# .env 는 .gitignore 에 등록되어 있습니다 — 절대 커밋하지 마세요.

OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# (선택) 실험 6 학습 생성 시 rate limit 분산용 보조 OpenAI 키.
# 지정하지 않으면 OPENAI_API_KEY 를 그대로 사용합니다.
# OPENAI_API_KEY2=your_second_openai_api_key_here
